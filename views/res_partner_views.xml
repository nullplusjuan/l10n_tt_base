<odoo>
    <record id="view_partner_form_l10n_tt" model="ir.ui.view">
        <field name="name">res.partner.form.l10n.tt</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='city'])[1]" position="after">
                <field name="tt_area_id" placeholder="TT Area / Community" options="{'no_create': True}"/>
                <field name="occupation_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
